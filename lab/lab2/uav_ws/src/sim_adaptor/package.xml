<?xml version="1.0"?>
<package format="2">
  <name>sim_adaptor</name>
  <version>0.0.1</version>
  <description>ROS1 adaptor for ELEC5660 simulator (mavros mock + RC mapping).</description>
  <maintainer email="dji@example.com">dji</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>

  <exec_depend>joy</exec_depend>
</package>
